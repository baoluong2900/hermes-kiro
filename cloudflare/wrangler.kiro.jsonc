{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiro-edge-gateway",
  "main": "worker.gateway.js",
  "compatibility_date": "2025-02-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "kiro-go.hermesgate.app",
      "custom_domain": true
    },
    {
      "pattern": "kiro.hermesgate.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "KIRO_KV",
      "id": "5424d2f4fef6454ca8e2c54993a7107f"
    },
    {
      "binding": "KIROPOOL_KV",
      "id": "5424d2f4fef6454ca8e2c54993a7107f"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_KEY_QUOTA",
        "class_name": "ApiKeyQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-api-key-quota",
      "new_sqlite_classes": ["ApiKeyQuota"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "KiroPool Edge Gateway"
  }
}
